# Supabase — مشروع taqwim
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# قراءة قائمة التلاميذ من صورة (Gemini). بغيره يبقى الاستيراد من الملف واللصق.
GEMINI_API_KEY=
# اختياري: الافتراضي gemini-3.8-flash، وهو مجاني في الطبقة المجانية.
GEMINI_MODEL=

# بريد الدعم الرسمي: يظهر في /privacy و/delete-account وفي رسالة الحساب الموقوف، ويُكتب نفسه في Play Console.
# لا يوجد افتراضي في الشفرة: إن لم يُضبط تختفي فقرات التواصل. يُقرأ وقت البناء (NEXT_PUBLIC_):
# لا يكفي أن يوجد هنا، بل يُضبط في Vercel (Production وPreview) ثم يلزم نشر جديد.
NEXT_PUBLIC_CONTACT_EMAIL=taqwimsupport@gmail.com
